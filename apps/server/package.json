{
  "name": "@games/server",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify backend server",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:down": "tsx src/db/migrate.ts down",
    "db:migrate:status": "tsx src/db/migrate.ts status",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:reset": "tsx src/db/seed.ts reset"
  },
  "devDependencies": {
    "@games/eslint-config": "workspace:*",
    "@games/typescript-config": "workspace:*",
    "@types/ioredis-mock": "^8.2.6",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.12",
    "eslint": "^9.39.1",
    "ioredis-mock": "^8.13.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.12"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@games/config": "workspace:*",
    "@games/constants": "workspace:*",
    "@games/types": "workspace:*",
    "@games/utils": "workspace:*",
    "@games/validation": "workspace:*",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "argon2": "^0.44.0",
    "bullmq": "^5.64.1",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.8.2",
    "kysely": "^0.28.8",
    "pg": "^8.16.3",
    "postmark": "^4.0.5",
    "zod": "^4.1.12"
  },
  "optionalDependencies": {
    "@types/pg": "^8.15.6"
  }
}
