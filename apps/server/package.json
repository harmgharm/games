{
  "name": "@games/server",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify backend server",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:down": "tsx src/db/migrate.ts down",
    "db:migrate:status": "tsx src/db/migrate.ts status",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:reset": "tsx src/db/seed.ts reset"
  },
  "devDependencies": {
    "@games/eslint-config": "workspace:*",
    "@games/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@games/config": "workspace:*",
    "@games/constants": "workspace:*",
    "@games/types": "workspace:*",
    "@games/validation": "workspace:*",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@types/pg": "^8.11.10"
  }
}
