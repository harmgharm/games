{
  "name": "@games/server",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify backend server",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:down": "tsx src/db/migrate.ts down",
    "db:migrate:status": "tsx src/db/migrate.ts status",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:reset": "tsx src/db/seed.ts reset"
  },
  "devDependencies": {
    "@games/eslint-config": "workspace:*",
    "@games/typescript-config": "workspace:*",
    "@types/ioredis-mock": "^8.2.6",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "ioredis-mock": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@games/config": "workspace:*",
    "@games/constants": "workspace:*",
    "@games/types": "workspace:*",
    "@games/utils": "workspace:*",
    "@games/validation": "workspace:*",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "argon2": "^0.44.0",
    "bullmq": "^5.63.2",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.8.2",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "postmark": "^4.0.5",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@types/pg": "^8.11.10"
  }
}
