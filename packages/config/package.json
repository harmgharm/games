{
  "name": "@games/config",
  "version": "0.0.0",
  "private": true,
  "description": "Server configuration factories (logger, db, redis)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./logger": {
      "import": "./src/logger.ts",
      "types": "./src/logger.ts"
    },
    "./database": {
      "import": "./src/database.ts",
      "types": "./src/database.ts"
    },
    "./redis": {
      "import": "./src/redis.ts",
      "types": "./src/redis.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@games/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@games/types": "workspace:*",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "optionalDependencies": {
    "@types/pg": "^8.11.10"
  }
}
