{
  "name": "@games/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared types, utilities, and constants for @games monorepo",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
